# ==================== DeepSeek API 配置 ====================
# 请将 your_api_key_here 替换为你的 DeepSeek API Key
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ==================== 管理员密钥 ====================
# 知识库管理操作（上传/删除/移动/列表）需要的密钥，聊天问答不受影响。
# 未配置时管理接口允许匿名访问（仅建议本地开发这样做）
ADMIN_KEY=your_admin_key_here

# ==================== Docker 部署配置（可选） ====================
# Nginx 前端服务的宿主机端口，默认 80；若被占用可改为 8080 等
# NGINX_PORT=8080
# HuggingFace 镜像站（镜像内已默认 https://hf-mirror.com，如需直连官方可设为 https://huggingface.co）
# HF_ENDPOINT=https://hf-mirror.com
