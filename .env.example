# ==================== DeepSeek API 配置 ====================
# 请将 your_api_key_here 替换为你的 DeepSeek API Key
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ==================== 管理员账号（知识库管理面登录） ====================
# 知识库管理操作（上传/删除/移动/列表）需要登录；聊天问答不受影响。
# 生产环境务必修改默认密码！
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# 令牌签名密钥（可选）：不配置则每次重启后需重新登录
# SECRET_KEY=change_me_to_a_random_string

# ==================== Docker 部署配置（可选） ====================
# Nginx 前端服务的宿主机端口，默认 80；若被占用可改为 8080 等
# NGINX_PORT=8080
# HuggingFace 镜像站（镜像内已默认 https://hf-mirror.com，如需直连官方可设为 https://huggingface.co）
# HF_ENDPOINT=https://hf-mirror.com
